{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkslide",
  "mainBinaryName": "inkslide",
  "version": "0.1.0",
  "identifier": "io.github.ansgomez.inkslide",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @inkslide/web dev",
    "beforeBuildCommand": "pnpm --filter @inkslide/web build:tauri"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Inkslide", "width": 1200, "height": 800, "dragDropEnabled": false }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' blob: data: ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Annotate PDFs with a pen",
    "copyright": "© Andres Gomez, MIT License",
    "icon": [
      "../../desktop/build/icons/32x32.png",
      "../../desktop/build/icons/128x128.png",
      "../../desktop/build/icons/256x256.png",
      "../../desktop/build/icons/512x512.png",
      "../../desktop/build/icon.icns",
      "../../desktop/build/icon.ico"
    ],
    "iOS": { "minimumSystemVersion": "17.0" },
    "android": { "minSdkVersion": 26 }
  }
}
